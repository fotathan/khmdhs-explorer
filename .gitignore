# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtual environments
khmdhs-env/
venv/
.venv/

# Secrets / local env — NEVER commit these
.env
.env.*
*.secret
# PSTN SIP trunk credentials (pulled into pjsip.conf via #tryinclude)
telephony/asterisk/pjsip_trunk.conf

# Local job logs
/tmp/khmdhs-jobs/

# OS / editor
.DS_Store
.idea/
.vscode/

# Data dumps (don't commit large CSVs/DB dumps unless you mean to)
*.dump
*.sql.gz
backups/          # pg_dump output from backup.sh (contains personal data)

# Local-only attachment binaries (see app/attachments.py)
attachment_store/

# Local preview launch config (contains local DB credentials)
.claude/

# Local digest emails written by EMAIL_BACKEND=file (see LOCAL_RUNBOOK.md)
outbox/
